# Serves the entity-page incoming references, capped at 51 so the page can
# show 50 and an overflow note.
PREFIX ont: <@@ONT@@>
SELECT ?g ?s ?p ?label WHERE {
  GRAPH ?g { ?s ?p <@@IRI@@> }
  FILTER(!isBlank(?s))
  FILTER(?g != <@@DEFS@@> && ?g != <@@CATALOG@@>)
  # As in entity.rq: references a source states, not placements the
  # reasoner derived, which would otherwise appear here unmarked and
  # contradict the children list on the same page.
  FILTER(!STRSTARTS(STR(?g), "@@INFPREFIX@@"))
  # A shared entity has one description per source. Use only the label
  # owned by the graph asserting this reference, without dropping an
  # incoming triple whose source supplies no indexed label.
  OPTIONAL {
    GRAPH <@@CATALOG@@> { ?source ont:namedGraph ?g }
    GRAPH <@@DEFS@@> {
      ?entry ont:entity ?s ; ont:fromSource ?source ; ont:label ?label
    }
  }
}
ORDER BY ?p ?s ?g
LIMIT 51
