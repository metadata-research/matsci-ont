# Serves search: word-boundary match over labels and definitions. The
# boundary is required, the recorded lesson being that substring search
# matches hasInteractionVolume for "sinter". The pattern is Java regex,
# case-insensitive, and the search string arrives with its metacharacters
# escaped.
PREFIX ont: <@@ONT@@>
SELECT ?s ?label ?definition ?key WHERE {
  GRAPH <@@DEFS@@> {
    ?entry ont:entity ?s ; ont:label ?label ; ont:sourceKey ?key .
    OPTIONAL { ?entry ont:definition ?definition }
    BIND(IF(LCASE(STR(?label)) = LCASE(@@TEXT@@), 0,
      IF(REGEX(STR(?label), CONCAT("\\b", @@REGEX@@), "i"), 1, 2)) AS ?tier)
    FILTER(?tier < 2 ||
      (BOUND(?definition) && REGEX(STR(?definition), CONCAT("\\b", @@REGEX@@), "i")))
  }
}
ORDER BY ?tier ?key ?label ?s
LIMIT 200
