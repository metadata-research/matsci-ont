# Loads one source's descriptions into the application's lookup index
# (app/lib/lookup-index.mjs), which answers the candidate and grounding
# lookups without scanning the store for each request.
#
# Every pattern the two lookups join is read here: the label, the optional
# definition, version and licence, and whether the entity is a class or
# concept in the source's own graph, the same test as candidate-source.rq.
#
# LCASE of a capital sigma depends on the word around it, by a rule that
# JavaScript does not share, so for a label with one the store returns its
# own lowercase as ?lower. ?none is never bound, so every other label leaves
# ?lower unbound and costs nothing to send.
#
# There is no ORDER BY, so the store streams rows as it finds them instead
# of holding the whole answer. A streamed answer cut short at a line would
# look complete, so the UNION adds one last row binding only ?end, and a
# load that does not see it is discarded.
PREFIX ont: <@@ONT@@>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?iri ?label ?definition ?version ?license ?typed ?lower ?end WHERE {
  {
    GRAPH <@@DEFS@@> {
      ?entry ont:sourceKey @@KEY@@ ; ont:entity ?iri ; ont:label ?label .
      OPTIONAL { ?entry ont:definition ?definition }
      OPTIONAL { ?entry ont:sourceVersion ?version }
      OPTIONAL { ?entry ont:license ?license }
    }
    BIND(EXISTS {
      GRAPH <@@GRAPH@@> { ?iri a ?type }
      VALUES ?type { owl:Class rdfs:Class skos:Concept }
    } AS ?typed)
    BIND(IF(CONTAINS(STR(?label), "\u03A3"), LCASE(STR(?label)), ?none) AS ?lower)
  }
  UNION
  { BIND(true AS ?end) }
}
