# Serves the catalogue page: one row per source with its entry count.
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX void:    <http://rdfs.org/ns/void#>
PREFIX ont:     <@@ONT@@>
SELECT ?key ?title ?version ?license ?ontologyIri ?graphIri ?triples ?entries
       ?republishable ?mirrorOf ?authorityBase ?mirroredFrom WHERE {
  GRAPH <@@CATALOG@@> {
    ?src ont:sourceKey ?key ;
         dcterms:title ?title ;
         dcterms:license ?license ;
         ont:namedGraph ?graphIri ;
         ont:republishable ?republishable ;
         void:triples ?triples .
    # A mirror states none of these: it is not pinned to a version and has
    # no ontology IRI of its own.
    OPTIONAL { ?src dcterms:hasVersion ?version }
    OPTIONAL { ?src ont:ontologyIri ?ontologyIri }
    OPTIONAL { ?src ont:mirrorOf ?mirrorOf }
    OPTIONAL { ?src ont:authorityBase ?authorityBase }
    OPTIONAL { ?src ont:mirroredFrom ?mirroredFrom }
  }
  OPTIONAL {
    SELECT ?key (COUNT(?e) AS ?entries) WHERE {
      GRAPH <@@DEFS@@> { ?e ont:sourceKey ?key }
    } GROUP BY ?key
  }
}
ORDER BY ?key
